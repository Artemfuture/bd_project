# Скопируйте в .env и подставьте свой пароль PostgreSQL.
# Формат: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/БАЗА
DATABASE_URL=postgresql://postgres:ВАШ_ПАРОЛЬ@localhost:5432/deanery

# Ключ подписи сессий. Если не задан, при каждом запуске создаётся новый
# (после перезапуска сервера придётся входить заново).
# SESSION_SECRET=длинная-случайная-строка

# SESSION_TTL_HOURS=12
# TRUSTED_HOSTS=127.0.0.1,localhost

# Отдельная база для тестов (создаётся и пересоздаётся автоматически)
# TEST_DATABASE_URL=postgresql://postgres:ВАШ_ПАРОЛЬ@localhost:5432/deanery_test
